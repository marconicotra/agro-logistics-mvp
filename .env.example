# ===== APP =====
APP_ENV=local
APP_NAME=agro-logistics
APP_PORT=8000
STORAGE_BACKEND=memory

# ===== DATABASE =====
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agro_logistics
DB_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agro_logistics
DB_USER=postgres
DB_PASSWORD=postgres

# (futuro)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Initial server-controlled administrator subject; set only after Supabase Auth is connected.
SUPABASE_BOOTSTRAP_ADMIN_USER_ID=
# Public frontend settings; safe to bundle in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== WHATSAPP / KAPSO =====
WHATSAPP_PROVIDER=mock
ENABLE_REAL_WHATSAPP=false
# Deprecated for inbound auth: local/staging fallback only.
WHATSAPP_DEV_ALLOWLIST=
WHATSAPP_ALLOWLIST_SOURCE=db_then_env
WHATSAPP_ALLOWLIST_DEFAULT_ALLOW=false
ENABLE_TEST_ROLE_SWITCHING=false

# Kapso
# Real outbound requiere opt-in explicito: WHATSAPP_PROVIDER=kapso + ENABLE_REAL_WHATSAPP=true.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_TIMESTAMP_TOLERANCE_SECONDS=300
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
KAPSO_PHONE_NUMBER_ID=
KAPSO_SEND_MESSAGE_PATH=/messages
# Template aprobado para reabrir la ventana WhatsApp 24h al enviar cargas.
# Variables body sugeridas: {{1}} carga, {{2}} ruta, {{3}} fecha/hora, {{4}} observaciones.
KAPSO_NEW_LOAD_TEMPLATE_NAME=agro_new_load_available
KAPSO_TEMPLATE_LANGUAGE_CODE=es_AR
# Experimental: envia botones interactivos cuando el shape KAPSO este validado.
# Default seguro: false, usa fallback textual numerado.
KAPSO_INTERACTIVE_ENABLED=false

# Meta (fallback o futuro)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_SECRET=

# ===== AI =====
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ===== SPEECH TO TEXT =====
STT_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
STT_ENABLED=false
STT_TIMEOUT_SECONDS=45
STT_MAX_AUDIO_BYTES=25000000

# ===== MEDIA / UPLOADS =====
MEDIA_STORAGE_DIR=var/media
MEDIA_DOWNLOAD_ENABLED=false
MEDIA_MAX_DOWNLOAD_BYTES=10000000

# ===== INTERNAL =====
# Required outside local/development; use a random value with at least 32 characters.
INTERNAL_API_KEY=
WEBHOOK_SECRET=

# ===== QUEUE / JOBS =====
QUEUE_PROVIDER=local

# ===== LOGGING =====
LOG_LEVEL=info

# Recorridos: claves separadas y restringidas por API/origen. No usar la clave del servidor en VITE_*.
ROUTE_OPERATIONS_ENABLED=true
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_ROUTES_DAILY_LIMIT=100
